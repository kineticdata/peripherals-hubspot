        "config": {
          "path": "crm/v3/objects/contacts/search",
          "params": {},
          "body": {
            "raw": "{\n    \"filterGroups\": [\n      {\n        \"filters\": [\n          {\n            \"propertyName\": \"email\",\n            \"operator\": \"CONTAINS_TOKEN\",\n            \"value\": \"{{email}}\"\n          }\n        ]\n      }\n    ]\n  }",
            "bodyType": "raw"
          },
          "headers": {
            "content-type": "application/json"
          },
          "configType": "http",
          "method": "POST",
          "includeEmptyParams": false,
          "followRedirect": false,
          "streamResponse": false
        },
        "outputs": {
          "user": {
            "children": {
              "FullName": "current.properties.firstname + \" \" + current.properties.lastname",
              "email": "current.properties.email",
              "id": "current.id"
