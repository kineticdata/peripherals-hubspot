          "params": {},
          "body": {
            "raw": "{\n  \"associations\": [\n    {\n      \"types\": [\n        {\n          \"associationCategory\": \"HUBSPOT_DEFINED\",\n          \"associationTypeId\": 578\n        }\n      ],\n      \"to\": {\n        \"id\": \"{{objectIDtoAssociateTo}}\"\n      }\n    }\n  ],\n  \"properties\": {\n    \"hs_lead_name\": \"{{leadName}}\",\n    \"hs_lead_type\": \"{{leadType}}\",\n    \"hs_lead_label\": \"{{leadLabel}}\",\n    \"submitting_partner\": \"{{submittingPartner}}\",\n    \"hubspot_owner_id\": \"{{LeadOwnerID}}\"\n  }\n}",
            "bodyType": "raw"
          },
          "headers": {
            "content-type": "application/json"
          },
          "configType": "http",
          "method": "POST",
          "includeEmptyParams": false,
          "followRedirect": false,
          "streamResponse": false
        },
        "outputs": {
          "leadID": {
            "value": "body.id"
          }
