          "params": {},
          "body": {
            "raw": "{\n  \"columns\": [\n                 {\n                   \"name\" : \"name\",\n                   \"label\" : \"Name\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                   \"name\" : \"slug\",\n                   \"label\" : \"Slug\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                   \"name\" : \"integration_type\",\n                   \"label\" : \"Integration Type\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                   \"name\" : \"version\",\n                   \"label\" : \"Version\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                   \"name\" : \"description\",\n                   \"label\" : \"Description\",\n                   \"limit\" : 65000,\n                   \"type\" : \"RICHTEXT\"\n                 },\n                 {\n                   \"name\" : \"repository_location\",\n                   \"label\" : \"Repository Location\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                   \"name\" : \"download_location\",\n                   \"label\" : \"Download Location\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                   \"name\" : \"parameters\",\n                   \"label\" : \"Parameters\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                   \"name\" : \"results\",\n                   \"label\" : \"Results\",\n                   \"type\" : \"TEXT\"\n                 },\n                 {\n                  \"name\" : \"configurations\",\n                  \"label\" : \"Configurations\",\n                  \"type\" : \"TEXT\"\n                },\n                 {\n                   \"name\" : \"changelog\",\n                   \"label\" : \"Change Log\",\n                   \"limit\" : 65000,\n                   \"type\" : \"RICHTEXT\"\n                 }\n   ]\n}",
