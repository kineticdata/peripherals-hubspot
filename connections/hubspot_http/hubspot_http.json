          "params": {},
          "body": {
            "raw": "{\n  \"properties\": {\n    \"hs_timestamp\": \"{{timestamp}}\",\n    \"hs_note_body\": \"{{noteBody}}\",\n    \"hubspot_owner_id\": \"{{ownerID}}\",\n    \"hs_attachment_ids\": \"{{attachmentIDs}}\"\n  },\n  \"associations\": [\n    {\n      \"to\": {\n        \"id\": {{companyID}}\n      },\n      \"types\": [\n        {\n          \"associationCategory\": \"HUBSPOT_DEFINED\",\n          \"associationTypeId\": 190\n        }\n      ]\n    }\n  ]\n}",
            "bodyType": "raw"
          },
